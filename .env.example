# LeonidaVice — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Supabase (required) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Optional platform API keys ────────────────────────────────────────────────
# Kick.com OAuth (required for Kick fetcher)
KICK_CLIENT_ID=your-kick-client-id
KICK_CLIENT_SECRET=your-kick-client-secret

# Imgur Client-ID — free at https://api.imgur.com/oauth2/addclient
# Without this, Imgur fetcher falls back to HTML scraping (fewer results)
IMGUR_CLIENT_ID=your-imgur-client-id

# ── Cron security (optional but recommended on Vercel) ────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret

# ── Crawler webhook (optional) ────────────────────────────────────────────────
# URL of a Cloud Run / Fly.io sidecar that runs yt-dlp manifest refreshes.
# Leave blank to disable automatic manifest refresh via webhook.
CRAWLER_WEBHOOK_URL=
CRAWLER_WEBHOOK_SECRET=

# ── VLM content filter Phase 2 (optional) ────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key
